# Managed by ansible.
# file: {{ template_destpath }}

[global]
{% set journal_options = {'debug timestamp': false} if __samba_ad_dc_journal else {} %}
{% for key, value in (__samba_ad_dc_global_defaults | combine(journal_options, samba_ad_dc_global_options)).items() %}
    {{ key }} = {{ value | ternary('yes', 'no') if value is boolean else value }}
{% endfor %}

[sysvol]
    path = {{ __samba_ad_dc_sysvol_dir }}
    read only = no
    vfs objects = full_audit dfs_samba4 acl_xattr

[netlogon]
    path = {{ __samba_ad_dc_sysvol_dir }}/{{ samba_ad_dc_realm | lower }}/scripts
    read only = no
    vfs objects = full_audit dfs_samba4 acl_xattr
